# Configurações de Produção - Essência Nutri Pet (VPS Hostinger)

# Banco de Dados (SQLite em volume Docker persistente)
DATABASE_URL="file:/app/prisma/dev.db"

# Ambiente de Execução
NODE_ENV="production"
PORT=3000

# Chave Anthropic Claude (Opcional - a extração e pareceres já funcionam 100% offline localmente)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
