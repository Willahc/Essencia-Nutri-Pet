// Prisma Schema for Essência Nutri Pet
// Relational persistence for longitudinal patient tracking, exams, diets, and tutor adherence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tutor {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patients  Patient[]
}

model Patient {
  id              String          @id @default(uuid())
  tutorId         String
  tutor           Tutor           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name            String
  species         String          // CANINE | FELINE
  breed           String
  birthDate       String?
  sex             String          // MALE | FEMALE
  isNeutered      Boolean         @default(true)
  idealWeightKg   Float
  currentWeightKg Float
  currentBcs      Int             @default(5)
  avatarUrl       String?
  comorbidities   String?         // JSON array string
  allergies       String?         // JSON array string
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  measurements    Measurement[]
  appointments    Appointment[]
  plans           NutritionPlan[]
  dailyLogs       TutorDailyLog[]
  exams           ExamDocument[]
}

model Measurement {
  id                       String   @id @default(uuid())
  patientId                String
  patient                  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                     String
  weightKg                 Float
  bcs                      Int
  abdominalCircumferenceCm Float?
  thoracicCircumferenceCm  Float?
  measuredBy               String?
  notes                    String?
  createdAt                DateTime @default(now())
}

model Appointment {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId     String
  professionalName   String
  type               String   // CONSULTORIA_NUTRICIONAL | RETORNO | etc
  status             String   @default("FINALIZADO")
  occurredAt         String
  version            Int      @default(1)
  notes              String?
  anamnesisJson      String?  // JSON string
  dietRecommendation String?
  createdAt          DateTime @default(now())
}

model NutritionPlan {
  id                   String   @id @default(uuid())
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  version              Int      @default(1)
  title                String
  feedingType          String   // NATURAL_COOKED | COMMERCIAL_DRY | MIXED_FEEDING
  dailyEnergyKcal      Int
  mealsPerDay          Int      @default(2)
  hydrationTargetMlDay Int
  transitionPlanDays   Int      @default(7)
  professionalId       String
  isActive             Boolean  @default(true)
  approvedAt           String
  notes                String?
  itemsJson            String   // JSON string of NutritionPlanItem[]
  supplementsJson      String   // JSON string of string[]
  createdAt            DateTime @default(now())
}

model TutorDailyLog {
  id                     String   @id @default(uuid())
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                   String
  transitionDay          Int
  dietConsumedPercentage Int      @default(100)
  waterIntakeMl          Int
  stoolScore             Int      @default(2)
  stoolNotes             String?
  appetite               String   @default("NORMAL")
  vomitingEpisodes       Int      @default(0)
  supplementsTaken       Boolean  @default(true)
  treatsGiven            Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
}

model ExamDocument {
  id                   String   @id @default(uuid())
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId        String?
  laboratoryName       String
  examDate             String
  fileName             String
  fileUrl              String
  fileHashSha256       String?
  extractionStatus     String   @default("PENDING_REVIEW")
  extractedResultsJson String   // JSON string of ExamParameterResult[]
  patientDetectedJson  String?  // JSON string
  tutorDetectedJson    String?  // JSON string
  professionalNotes    String?
  reviewedAt           String?
  reviewedBy           String?
  createdAt            DateTime @default(now())
}
