# ========================================================
# Variáveis de Ambiente - Essência Nutri Pet
# ========================================================

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://nutripet_user:nutripet_secure_pass@localhost:5432/nutripet_db"

# Autenticação e Segurança
NEXTAUTH_SECRET="chave_secreta_aleatoria_para_assinatura_de_sessoes"
NEXTAUTH_URL="http://localhost:3000"

# ========================================================
# Provedor de IA Principal: Anthropic Claude
# Obtenha sua chave em: https://console.anthropic.com/settings/keys
# ========================================================
ANTHROPIC_API_KEY=""
# Modelos sugeridos:
# - "claude-3-5-sonnet-20241022" (Padrão: máxima precisão clínica e leitura nativa de PDFs)
# - "claude-3-5-haiku-20241022" (Mais rápido e econômico)
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ========================================================
# Provedor Alternativo: OpenRouter (Opcional)
# ========================================================
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# ========================================================
# Armazenamento Privado de Exames (AWS S3 ou Cloudflare R2)
# ========================================================
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="essencia-nutri-pet-exams"
S3_REGION="auto"
