# ========================================================
# Variáveis de Ambiente - Essência Nutri Pet
# ========================================================

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://nutripet_user:nutripet_secure_pass@localhost:5432/nutripet_db"

# Autenticação e Segurança
NEXTAUTH_SECRET="chave_secreta_aleatoria_para_assinatura_de_sessoes"
NEXTAUTH_URL="http://localhost:3000"

# ========================================================
# Provedor de IA: OpenRouter (Recomendado)
# Obtenha sua chave em: https://openrouter.ai/keys
# ========================================================
OPENROUTER_API_KEY=""
# Modelos sugeridos:
# - "google/gemini-2.0-flash-001" (Rápido, multimodal e barato)
# - "anthropic/claude-3.5-sonnet" (Máxima precisão clínica)
# - "openai/gpt-4o-mini"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Provedor de IA: Google Gemini Nativo (Opcional se usar OpenRouter)
GEMINI_API_KEY=""

# Armazenamento Privado de Exames (AWS S3 ou Cloudflare R2)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="essencia-nutri-pet-exams"
S3_REGION="auto"
